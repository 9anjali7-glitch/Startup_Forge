# Optional free-tier Gemini API key for generated AI replies (no billing configured).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=chat-latest

# Paid Mistral is disabled unless you explicitly opt in.
MISTRAL_API_KEY=
ENABLE_MISTRAL_API=false

# Local Neo4j password (use 8+ characters)
NEO4J_PASSWORD=startupforge-local

# Browser origins allowed to call the local APIs. For cloud deployments, set
# these to the exact frontend origin(s), without trailing slashes.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional key for POST /setup-db and POST /seed-full. Leave blank to disable.
ADMIN_API_KEY=

# Name-only login is for local demos only. Production intentionally rejects it.
ALLOW_INSECURE_DEMO_LOGIN=false
